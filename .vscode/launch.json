{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run SecretariArt (http://localhost:5100)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build SecretariArt",
            "program": "${workspaceFolder}/src/SecretariArt/bin/Debug/net10.0/SecretariArt.dll",
            "cwd": "${workspaceFolder}/src/SecretariArt",
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5100"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}
