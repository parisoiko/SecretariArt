@page "/account/reset-password"
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(RateLimitPolicies.AccountRecovery)]
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.RateLimiting
@using SecretariArt.Extensions
@using SecretariArt.ViewModels
@inject UserManager<ApplicationUser> Users
@inject FlashMessageService Flash
@inject NavigationManager Navigation

@* Choose a new password, from the emailed link. Replaces AccountController.ResetPassword and its view. *@

<PageTitle>Choose a new password · SecretariArt</PageTitle>

<h2>Choose a new password</h2>
<p class="text-muted">For <span><EmailText Value="@Input.Email" /></span>. At least 8 characters, with an upper-case
   letter, a lower-case letter and a digit.</p>

<EditForm EditContext="editContext" FormName="reset-password" OnValidSubmit="ResetAsync" OnInvalidSubmit="ForgetPasswords" method="post" novalidate>
    <DataAnnotationsValidator />
    @if (linkExpired)
    {
        <div class="alert alert-danger" role="alert">This reset link has expired or has already been used. Ask for a new one.</div>
        <p><a href="@($"account/forgot-password?email={Uri.EscapeDataString(Input.Email)}")">Send me a new link</a></p>
    }
    @* The link's email and code travel with the form; the code is what proves the email is yours. *@
    <InputText type="hidden" @bind-Value="Input.Email" />
    <InputText type="hidden" @bind-Value="Input.Code" />
    @* Lets password managers save the new password against the right account. *@
    <input type="hidden" autocomplete="username" value="@Input.Email" />

    <div class="mb-3">
        <label for="password" class="form-label">New password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" autofocus />
        <ValidationMessage For="() => Input.Password" class="invalid-feedback d-block" />
    </div>
    <div class="mb-4">
        <label for="confirm-password" class="form-label">Confirm new password</label>
        <InputText id="confirm-password" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="invalid-feedback d-block" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Change password</button>
</EditForm>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    // Null on a plain visit (the link), filled from the form on a post; OnInitialized makes sure it's set before rendering.
    [SupplyParameterFromForm] private ResetPasswordViewModel Input { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "email")] private string? EmailFromLink { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? CodeFromLink { get; set; }

    private EditContext editContext = default!;
    private ValidationMessageStore serverErrors = default!;
    private bool linkExpired;

    protected override void OnInitialized()
    {
        if (Input == null)
        {
            // A plain visit: only with the link's email and code.
            if (string.IsNullOrEmpty(EmailFromLink) || string.IsNullOrEmpty(CodeFromLink))
            {
                Navigation.NavigateTo("account/forgot-password");
            }
            Input = new ResetPasswordViewModel { Email = EmailFromLink ?? "", Code = CodeFromLink ?? "" };
        }
        editContext = new EditContext(Input);
        serverErrors = new ValidationMessageStore(editContext);
    }

    private async Task ResetAsync()
    {
        // An unknown email gets the same answer as a bad link.
        ApplicationUser? user = await Users.FindByEmailAsync(Input.Email);
        IdentityResult result = user is null
            ? IdentityResult.Failed(new IdentityError { Code = "InvalidToken" })
            : await Users.ResetPasswordAsync(user, PasswordResetService.DecodeCode(Input.Code), Input.Password);
        if (result.Succeeded)
        {
            // Whoever was locked out by wrong guesses has now proved they own the email.
            await Users.SetLockoutEndDateAsync(user!, null);
            await Users.ResetAccessFailedCountAsync(user!);
            Flash.Success(HttpContext, "Your password has been changed. Sign in with the new one.");
            Navigation.NavigateTo($"account/login?email={Uri.EscapeDataString(Input.Email)}");
            return;
        }

        foreach (IdentityError error in result.Errors)
        {
            if (error.Code == "InvalidToken")
            {
                linkExpired = true;
            }
            else
            {
                serverErrors.Add(() => Input.Password, error.Description);
            }
        }
        editContext.NotifyValidationStateChanged();
        ForgetPasswords();
    }

    // InputText writes the field's value into the page, password fields included: never send a password back.
    private void ForgetPasswords()
    {
        Input.Password = "";
        Input.ConfirmPassword = "";
    }
}
