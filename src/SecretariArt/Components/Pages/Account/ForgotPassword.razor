@page "/account/forgot-password"
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(RateLimitPolicies.AccountRecovery)]
@layout AuthLayout
@using Microsoft.AspNetCore.RateLimiting
@using SecretariArt.Extensions
@using SecretariArt.ViewModels
@inject IPasswordResetService PasswordReset
@inject NavigationManager Navigation

@*
    "Forgot your password?" and, once sent, "Check your email": the first Blazor form. Replaces the two
    AccountController.ForgotPassword actions and the views ForgotPassword and ForgotPasswordSent.
*@

@if (sentTo == null)
{
    <PageTitle>Forgot your password? · SecretariArt</PageTitle>

    <h2>Forgot your password?</h2>
    <p class="text-muted">Enter the email you signed up with and we'll send you a link to choose a new password.</p>

    @* FormName names this form on the page: it is posted back as the hidden field _handler, and tells Blazor which
       form's OnValidSubmit to run. The anti-forgery token is added by EditForm itself. *@
    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SendAsync" method="post" novalidate>
        <DataAnnotationsValidator />

        <div class="mb-4">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" @bind-Value="Input!.Email" class="form-control" autocomplete="username" autofocus />
            <ValidationMessage For="() => Input!.Email" class="invalid-feedback d-block" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Send the link</button>
    </EditForm>

    <p class="mt-4 mb-0 text-center">
        Remembered it? <a href="@($"account/login?email={Uri.EscapeDataString(Input!.Email)}")">Sign in</a>
    </p>
}
else
{
    <PageTitle>Check your email · SecretariArt</PageTitle>

    <h2>Check your email</h2>
    <p>If <strong><EmailText Value="@sentTo" /></strong> has an account, we've sent it a link to choose a new password.
       The link works for two hours.</p>
    <p class="text-muted">Nothing arrived? Check your spam folder, or
       <a href="@($"account/forgot-password?email={Uri.EscapeDataString(sentTo)}")">ask again</a>.</p>

    <a class="btn btn-primary w-100 mt-2" href="@($"account/login?email={Uri.EscapeDataString(sentTo)}")">Back to sign in</a>
}

@code {
    // Filled from the posted form (fields "Input.Email", …) when this form is submitted; null on a plain GET.
    [SupplyParameterFromForm] private ForgotPasswordViewModel? Input { get; set; }

    // ?email=… from the sign-in page's "Forgot your password?" link, to save typing it again.
    [SupplyParameterFromQuery(Name = "email")] private string? EmailFromLink { get; set; }

    // Set once the link has gone out: the page then shows "Check your email".
    private string? sentTo;

    protected override void OnInitialized() => Input ??= new ForgotPasswordViewModel { Email = EmailFromLink ?? "" };

    // Runs only when the posted form is valid ([Required], [EmailAddress] on ForgotPasswordViewModel). The answer is the
    // same whether or not the address has an account.
    private async Task SendAsync()
    {
        string email = Input!.Email.Trim();
        await PasswordReset.SendLinkAsync(email, Navigation.BaseUri);
        sentTo = email;
    }
}
