@page "/account/login"
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(RateLimitPolicies.SignIn)]
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.RateLimiting
@using SecretariArt.Extensions
@using SecretariArt.ViewModels
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation

@* Sign in. Replaces AccountController.Login (GET and POST) and Views/Account/Login.cshtml. *@

<PageTitle>Sign in · SecretariArt</PageTitle>

<h2>Welcome back</h2>
<p class="text-muted">Sign in with your email and password.</p>
<FlashMessages />

<EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" OnInvalidSubmit="ForgetPassword" method="post" novalidate>
    <DataAnnotationsValidator />
    @if (problem != null)
    {
        <div class="alert alert-danger" role="alert">@problem</div>
    }

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" @bind-Value="Input!.Email" class="form-control" autocomplete="username" autofocus />
        <ValidationMessage For="() => Input!.Email" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-baseline">
            <label for="password" class="form-label">Password</label>
            <a class="small" href="@($"account/forgot-password?email={Uri.EscapeDataString(Input!.Email)}")">Forgot your password?</a>
        </div>
        <InputText id="password" type="password" @bind-Value="Input!.Password" class="form-control" autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" class="invalid-feedback d-block" />
    </div>
    <div class="form-check mb-4">
        <InputCheckbox id="remember" @bind-Value="Input!.RememberMe" class="form-check-input" />
        <label for="remember" class="form-check-label">Keep me signed in</label>
    </div>

    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</EditForm>

<p class="mt-4 mb-0 text-center">
    New here? <a href="@WithReturnUrl("account/register")">Create an account</a>
</p>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginViewModel? Input { get; set; }

    // Where to go after signing in (set when a page sent the visitor here), and the email when arriving from
    // "Sign in instead" on the registration form.
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? EmailFromLink { get; set; }

    private string? problem;

    protected override void OnInitialized()
    {
        // Someone already signed in has nothing to do here. NavigateTo during static rendering becomes a redirect.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(LocalUrls.OrHome(ReturnUrl));
        }
        Input ??= new LoginViewModel { Email = EmailFromLink ?? "" };
    }

    private async Task SignInAsync()
    {
        // The user name is the email address. Signing in writes the cookie into this response, which works because a
        // static page's response hasn't started while its form handler runs.
        SignInResult result = await SignIn.PasswordSignInAsync(Input!.Email.Trim(), Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Navigation.NavigateTo(LocalUrls.OrHome(ReturnUrl));
            return;
        }

        // One message for unknown email and wrong password, so the form doesn't reveal who has an account.
        problem = result.IsLockedOut ? "Too many failed attempts. Try again in a few minutes." : "Wrong email or password.";
        ForgetPassword();
    }

    // InputText writes the field's value into the page, password fields included: never send a password back.
    private void ForgetPassword() => Input!.Password = "";

    private string WithReturnUrl(string path) =>
        string.IsNullOrEmpty(ReturnUrl) ? path : $"{path}?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
