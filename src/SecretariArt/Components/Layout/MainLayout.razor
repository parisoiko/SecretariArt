@inherits LayoutComponentBase
@using System.Security.Claims

@*
    The layout of every page for signed-in people: the Blazor version of Views/Shared/_Layout.cshtml. The navigation is
    its own component (MainNav); the page goes where @Body is.
*@
<a class="skip-link" href="#content">Skip to content</a>
<nav class="navbar navbar-expand-lg app-navbar" aria-label="Main">
    <div class="container">
        <a class="navbar-brand" href="/" aria-label="SecretariArt home"><Logo /></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <MainNav />
            <div class="dropdown ms-lg-2">
                <button class="btn user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="Account menu for @firstName">
                    <span class="avatar">@initials</span>
                    @firstName
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="account/profile"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>My account</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="join"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Join an organisation</a></li>
                    <li><a class="dropdown-item" href="organizations/request"><i class="bi bi-building-add me-2" aria-hidden="true"></i>Register an organisation</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        @* A plain HTML form posting to the sign-out endpoint (Extensions/AccountEndpoints.cs). <AntiforgeryToken />
                           writes the hidden token the endpoint checks. data-enhance="false": a normal post, not one
                           Blazor intercepts, since no Blazor page answers it. *@
                        <form action="account/logout" method="post" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<main class="container py-4" id="content" tabindex="-1">
    <FlashMessages />
    @Body
</main>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    private string? firstName;
    private string initials = "";

    protected override void OnInitialized()
    {
        // The name comes from the sign-in cookie (Services/AppClaimsPrincipalFactory.cs): no database query.
        firstName = HttpContext.User.FindFirstValue(ClaimTypes.GivenName);
        initials = $"{firstName?.FirstOrDefault()}{HttpContext.User.FindFirstValue(ClaimTypes.Surname)?.FirstOrDefault()}";
    }
}
