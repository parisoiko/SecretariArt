@model List<Classroom>
@{
    var organization = (Organization)ViewData["Organization"]!;
    ViewData["Title"] = $"Classrooms · {organization.Name}";
}

@{ Layout = "_AdminLayout"; ViewData["AdminTab"] = "classrooms"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted mb-0">The rooms sessions can take place in. Courses say what they need; the schedule only uses rooms that have it.</p>
    <a class="btn btn-primary" asp-action="Create" asp-route-organizationId="@organization.Id"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add classroom</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state small">
        <i class="bi bi-door-open" aria-hidden="true"></i>
        <p>No classrooms yet. Add the rooms you teach in, with how many people they hold and what they have
           (a piano, mirrors, a sprung floor…).</p>
    </div>
}
else
{
    <div class="table-responsive table-card">
        <table class="table align-middle mb-0 table-stack">
            <thead><tr><th>Classroom</th><th>Capacity</th><th>Floor</th><th>Features</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var classroom in Model)
                {
                    <tr>
                        <td data-label="Classroom">
                            <strong lang="@classroom.Name.Language()">@classroom.Name</strong>
                            @if (classroom.StepFreeAccess)
                            {
                                <span class="feature-badge" title="Step-free access"><i class="bi bi-universal-access" aria-hidden="true"></i> Step-free</span>
                            }
                            @if (classroom.Notes != null)
                            {
                                <div class="text-muted small">@classroom.Notes</div>
                            }
                        </td>
                        <td data-label="Capacity">@classroom.Capacity</td>
                        <td data-label="Floor">@classroom.Floor.Display()</td>
                        <td data-label="Features">
                            @foreach (var feature in classroom.Features.Split())
                            {
                                <span class="feature-badge">@feature.Display()</span>
                            }
                        </td>
                        <td class="text-end text-nowrap table-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-organizationId="@organization.Id"
                               asp-route-classroomId="@classroom.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
                            <form asp-action="Delete" asp-route-organizationId="@organization.Id" asp-route-classroomId="@classroom.Id"
                                  method="post" class="d-inline" data-confirm="Delete @classroom.Name?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
