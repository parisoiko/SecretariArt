@model MembersViewModel
@{
    ViewData["Title"] = $"Members · {Model.Organization.Name}";
}

<partial name="_AdminHeader" model="@("members")" />

@if (!Model.Setup.IsComplete)
{
    int organizationId = Model.Organization.Id;
    (bool Done, string Label, string Controller, string Action)[] steps =
    [
        (Model.Setup.RulesSaved, "Set your timetabling rules", "Rules", "Edit"),
        (Model.Setup.HasClassrooms, "Add your classrooms", "Classrooms", "Index"),
        (Model.Setup.HasCourseWithGroup, "Add a course with a group", "Courses", "Index"),
        (Model.Setup.HasStudents, "Invite and approve students (below)", "Administration", "Members"),
        (Model.Setup.HasEnrolments, "Enrol students", "Enrolments", "Index"),
    ];
    <section class="setup-card mb-4" aria-labelledby="setup-title">
        <h2 class="section-title" id="setup-title">Getting started <span class="text-muted small">@steps.Count(s => s.Done) of @steps.Length done</span></h2>
        <ol class="setup-steps">
            @foreach (var step in steps)
            {
                <li class="@(step.Done ? "done" : "")">
                    <i class="bi @(step.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                    @if (step.Done)
                    {
                        <span>@step.Label <span class="visually-hidden">(done)</span></span>
                    }
                    else
                    {
                        <a asp-controller="@step.Controller" asp-action="@step.Action" asp-route-organizationId="@organizationId">@step.Label</a>
                    }
                </li>
            }
        </ol>
    </section>
}

<section class="invite-panel mb-4">
    <div>
        <h2 class="section-title mb-1">Invite people</h2>
        <p class="text-muted mb-2">Share the code or the link. People who use it ask to join, and appear below for you to approve.</p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="invite-code">@Model.Organization.InviteCode</span>
            <input class="form-control invite-link" value="@Model.InviteLink" readonly aria-label="Invite link" onclick="this.select()" />
        </div>
    </div>
    <form asp-action="RegenerateInviteCode" asp-route-organizationId="@Model.Organization.Id" method="post"
          onsubmit="return confirm('Make a new code? The current code and link will stop working.');">
        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> New code</button>
    </form>
</section>

<section class="mb-4">
    <h2 class="section-title">Waiting for approval <span class="badge text-bg-warning">@Model.Pending.Count</span></h2>
    @if (Model.Pending.Count == 0)
    {
        <p class="text-muted">No one is waiting.</p>
    }
    else
    {
        <div class="table-responsive table-card">
            <table class="table align-middle mb-0 table-stack">
                <thead><tr><th>Name</th><th>Role</th><th>Contact</th><th>Asked</th><th></th></tr></thead>
                <tbody>
                    @foreach (var membership in Model.Pending)
                    {
                        string role = membership.Role.ToString().ToLowerInvariant();
                        <tr>
                            <td data-label="Name">
                                <strong>@membership.User!.FullName</strong>
                                @if (membership.LastRejectedAt is DateTime rejectedAt)
                                {
                                    @* They asked again after being turned down: say so, so the admin decides knowingly. *@
                                    <div class="text-danger small">
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Rejected before, on @rejectedAt.ToLocalTime().ToString("d MMM yyyy")@(membership.RejectionReason is string reason ? $": {reason}" : "")
                                    </div>
                                }
                            </td>
                            <td data-label="Role"><span class="role-badge role-@role">@membership.Role</span></td>
                            <td data-label="Contact">@membership.User.Email<div class="text-muted small">@membership.User.PhoneNumber</div></td>
                            <td data-label="Asked" class="text-nowrap">@membership.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td class="text-end text-nowrap table-actions">
                                <form asp-action="Approve" asp-route-organizationId="@Model.Organization.Id" asp-route-membershipId="@membership.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg" aria-hidden="true"></i> Approve</button>
                                </form>
                                @* A page of its own: it names the person and asks for the reason they'll see. *@
                                <a class="btn btn-sm btn-outline-danger" asp-action="Reject" asp-route-organizationId="@Model.Organization.Id"
                                   asp-route-membershipId="@membership.Id"><i class="bi bi-x-lg" aria-hidden="true"></i> Reject</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@{
    // One row per person, with a badge for each role they hold here.
    var people = Model.Active
        .GroupBy(m => m.UserId)
        .OrderBy(g => g.Min(m => m.Role)).ThenBy(g => g.First().User!.LastName).ThenBy(g => g.First().User!.FirstName)
        .ToList();
}
<section class="mb-4">
    <h2 class="section-title">Members <span class="badge text-bg-secondary">@people.Count</span></h2>
    <div class="table-responsive table-card">
        <table class="table align-middle mb-0 table-stack">
            <thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Phone</th></tr></thead>
            <tbody>
                @foreach (var person in people)
                {
                    ApplicationUser user = person.First().User!;
                    <tr>
                        <td data-label="Name">@user.FullName</td>
                        <td data-label="Role">
                            @foreach (var membership in person.OrderBy(m => m.Role))
                            {
                                <span class="role-badge role-@membership.Role.ToString().ToLowerInvariant()">@membership.Role</span>
                            }
                        </td>
                        <td data-label="Email">@user.Email</td>
                        <td data-label="Phone">@user.PhoneNumber</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.Rejected.Count > 0)
{
    <section>
        <h2 class="section-title">Not approved</h2>
        <p class="text-muted">The most recent requests you rejected. Approve one if it was a mistake.</p>
        <div class="table-responsive table-card">
            <table class="table align-middle mb-0 table-stack">
                <thead><tr><th>Name</th><th>Role</th><th>Contact</th><th>Rejected</th><th></th></tr></thead>
                <tbody>
                    @foreach (var membership in Model.Rejected)
                    {
                        <tr>
                            <td data-label="Name">
                                @membership.User!.FullName
                                @if (membership.RejectionReason != null)
                                {
                                    <div class="text-muted small">@membership.RejectionReason</div>
                                }
                            </td>
                            <td data-label="Role"><span class="role-badge role-@membership.Role.ToString().ToLowerInvariant()">@membership.Role</span></td>
                            <td data-label="Contact">@membership.User.Email<div class="text-muted small">@membership.User.PhoneNumber</div></td>
                            <td data-label="Rejected" class="text-nowrap">@membership.DecidedAt?.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td class="text-end text-nowrap table-actions">
                                <form asp-action="Approve" asp-route-organizationId="@Model.Organization.Id" asp-route-membershipId="@membership.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-success"><i class="bi bi-check-lg" aria-hidden="true"></i> Approve after all</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
