@model int
@{
    ViewData["Title"] = Model == 404 ? "Not found" : "Something went wrong";
    // Error pages can be shown to signed-out visitors, who don't have the app's navigation.
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}

<div class="empty-state">
    <i class="bi @(Model == 404 ? "bi-signpost-split" : "bi-exclamation-triangle")" aria-hidden="true"></i>
    <h1>@(Model == 404 ? "We couldn't find that page" : Model == 403 ? "You don't have access to this page" : "Something went wrong")</h1>
    <p>@(Model == 500 ? "Please try again in a moment." : "Check the address, or start again from the home page.")</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
