@model int
@{
    // 429: a rate limit (Extensions/RateLimiting.cs) said how long to wait.
    int? retryAfter = Context.Items[SecretariArt.Extensions.RateLimitPolicies.RetryAfterItem] as int?;
    string wait = retryAfter switch
    {
        null or <= 60 => "a minute",
        < 3600 => $"{(retryAfter + 59) / 60} minutes",
        _ => "an hour",
    };

    (string Title, string Icon, string Heading, string Text) info = Model switch
    {
        404 => ("Not found", "bi-signpost-split", "We couldn't find that page", "Check the address, or start again from the home page."),
        403 => ("Something went wrong", "bi-exclamation-triangle", "You don't have access to this page", "Check the address, or start again from the home page."),
        429 => ("Too many attempts", "bi-hourglass-split", "Too many attempts",
                $"To keep accounts safe, there's a limit on how often this can be tried. Please wait {wait} and try again."),
        500 => ("Something went wrong", "bi-exclamation-triangle", "Something went wrong", "Please try again in a moment."),
        _ => ("Something went wrong", "bi-exclamation-triangle", "Something went wrong", "Check the address, or start again from the home page."),
    };
    ViewData["Title"] = info.Title;
    // Error pages can be shown to signed-out visitors, who don't have the app's navigation.
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}

<div class="empty-state">
    <i class="bi @info.Icon" aria-hidden="true"></i>
    <h1>@info.Heading</h1>
    <p>@info.Text</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
