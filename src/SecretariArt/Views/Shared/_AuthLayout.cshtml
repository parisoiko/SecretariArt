<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body class="auth">
    <main class="auth-panel">
        <div class="auth-intro">
            <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="SecretariArt home"><partial name="_Logo" /></a>
            <h1>The front office for schools of the arts.</h1>
            <p>Schedules, classrooms, teachers' availability and students' payments, in one place, for drama schools,
               conservatoires, dance studios and ateliers.</p>
        </div>
        <div class="auth-card">
            @RenderBody()
        </div>
    </main>
    @* For the dismiss buttons on messages (e.g. "Your password has been changed"). *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
