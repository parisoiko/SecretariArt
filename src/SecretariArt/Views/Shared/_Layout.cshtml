@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body class="app">
    <nav class="navbar navbar-expand-md app-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">S</span>SecretariArt
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @await Component.InvokeAsync("MainNav")
                <div class="dropdown ms-md-3">
                    <button class="btn user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@(User.FindFirstValue(ClaimTypes.GivenName)?.FirstOrDefault())@(User.FindFirstValue(ClaimTypes.Surname)?.FirstOrDefault())</span>
                        @User.FindFirstValue(ClaimTypes.GivenName)
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Organizations" asp-action="Join"><i class="bi bi-person-plus me-2"></i>Join an organisation</a></li>
                        <li><a class="dropdown-item" asp-controller="Organizations" asp-action="RequestOrganization"><i class="bi bi-building-add me-2"></i>Register an organisation</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <partial name="_Messages" />
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
