@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body class="app">
    <nav class="navbar navbar-expand-lg app-navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="SecretariArt home">
                <partial name="_Logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @await Component.InvokeAsync("MainNav")
                @if (ViewData["AdminTab"] != null && ViewData["Organization"] is Organization)
                {
                    <partial name="_OrgSwitcher" />
                }
                <div class="dropdown ms-lg-2">
                    <button class="btn user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Account menu for @User.FindFirstValue(ClaimTypes.GivenName)">
                        <span class="avatar">@(User.FindFirstValue(ClaimTypes.GivenName)?.FirstOrDefault())@(User.FindFirstValue(ClaimTypes.Surname)?.FirstOrDefault())</span>
                        @User.FindFirstValue(ClaimTypes.GivenName)
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Organizations" asp-action="Join"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Join an organisation</a></li>
                        <li><a class="dropdown-item" asp-controller="Organizations" asp-action="RequestOrganization"><i class="bi bi-building-add me-2" aria-hidden="true"></i>Register an organisation</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <partial name="_Messages" />
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        // Forms marked data-confirm (deletes, removals) ask first; the text names what will go.
        document.addEventListener('submit', e => {
            const message = e.target.dataset?.confirm;
            if (message && !confirm(message)) { e.preventDefault(); }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
