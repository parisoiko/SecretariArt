@*
    Every administration page of one organisation: the sections on the left (a scrolling row on a phone), the page
    on the right with its heading. A page sets ViewData["AdminTab"] (the section) and may set ViewData["Heading"] and
    ViewData["Intro"]; the organisation comes from OrganizationAdminController.
*@
@{
    Layout = "_Layout";
    var organization = (Organization)ViewData["Organization"]!;
    string active = ViewData["AdminTab"] as string ?? "";
    string heading = ViewData["Heading"] as string
        ?? SecretariArt.ViewComponents.AdminSections.Groups.SelectMany(g => g.Links).FirstOrDefault(l => l.Key == active)?.Label
        ?? "Administration";
    // "Skip to content" skips the sidebar too (QA, A6): _Layout points it here.
    ViewData["SkipTo"] = "admin-content";
}

<div class="admin-shell">
    @await Component.InvokeAsync("AdminSidebar", new { organization, active })
    <div class="admin-main" id="admin-content" tabindex="-1">
        <div class="admin-heading">
            <div>
                <h1>@heading</h1>
                @if (ViewData["Intro"] is string intro)
                {
                    <p>@intro</p>
                }
            </div>
            @await RenderSectionAsync("HeadingAside", required: false)
        </div>
        @RenderBody()
    </div>
</div>

@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
