@model UserRoles
@{
    ViewData["Title"] = "Schedule";
}

<header class="page-header">
    <h1>Schedule</h1>
    <p>Your timetable across every organisation, in one calendar.</p>
</header>

<ul class="nav nav-tabs mb-4">
    @if (Model.IsStudent)
    {
        <li class="nav-item"><span class="nav-link active"><i class="bi bi-mortarboard" aria-hidden="true"></i> My classes</span></li>
    }
    @if (Model.IsTeacher)
    {
        <li class="nav-item"><span class="nav-link @(Model.IsStudent ? "" : "active")"><i class="bi bi-easel" aria-hidden="true"></i> Teaching</span></li>
        <li class="nav-item"><span class="nav-link"><i class="bi bi-calendar-check" aria-hidden="true"></i> Availability</span></li>
    }
</ul>

<div class="empty-state small">
    <i class="bi bi-calendar3" aria-hidden="true"></i>
    <p>Schedules arrive in the next milestone: teachers' availability, the admin schedule editor, and calendars that
       flag overlaps between organisations in red.</p>
</div>
