@model RecordPaymentModel
@{
    var organization = (Organization)ViewData["Organization"]!;
    var charge = Model.Charge;
    string id = $"pay-{charge.Id}";
}
@* A small form that opens in place, prefilled with what's still owed and today's date. *@
<details class="inline-form text-start">
    <summary class="btn btn-sm btn-primary"><i class="bi bi-cash-coin" aria-hidden="true"></i> Record payment</summary>
    <form asp-action="RecordPayment" asp-route-organizationId="@organization.Id" asp-route-chargeId="@charge.Id" method="post" class="inline-form-body">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <p class="small mb-2"><strong>@charge.Description</strong><br />@DisplayNames.Money(charge.Balance) to pay</p>
        <div class="mb-2">
            <label class="form-label small mb-1" for="@id-amount">Amount (€)</label>
            <input class="form-control form-control-sm" id="@id-amount" name="Amount" type="text" inputmode="decimal" autocomplete="off"
                   value="@charge.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1" for="@id-date">Paid on</label>
            <input class="form-control form-control-sm" id="@id-date" name="PaidOn" type="date" max="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Today.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1" for="@id-method">Paid by</label>
            <select class="form-select form-select-sm" id="@id-method" name="Method" required>
                @foreach (var method in PaymentDisplay.DeskMethods)
                {
                    <option value="@method">@method.Display()</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1" for="@id-ref">Receipt or reference <span class="text-muted">(optional)</span></label>
            <input class="form-control form-control-sm" id="@id-ref" name="Reference" maxlength="100" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary w-100">Save payment</button>
    </form>
</details>
