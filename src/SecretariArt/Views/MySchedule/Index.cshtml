@model PersonalScheduleViewModel
@inject TimeProvider Clock
@{
    ViewData["Title"] = Model.Tab switch { ScheduleTabs.Availability => "Availability", ScheduleTabs.Book => "Check in to classes", ScheduleTabs.CheckIns => "Who's coming", _ => "Schedule" };
    var clashes = Model.Sessions.Where(s => s.Clash != null).ToList();
}

<header class="page-header">
    <h1>Schedule</h1>
    <p>Your classes in every organisation, in one week. They repeat every week of each organisation's term.</p>
</header>

<nav aria-label="Schedule sections">
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == ScheduleTabs.Week ? "active" : "")" aria-current="@(Model.Tab == ScheduleTabs.Week ? "page" : null)"
               asp-action="Index"><i class="bi bi-calendar-week" aria-hidden="true"></i> My week</a>
        </li>
        @if (Model.Roles.IsTeacher)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.Tab == ScheduleTabs.Availability ? "active" : "")" aria-current="@(Model.Tab == ScheduleTabs.Availability ? "page" : null)"
                   asp-action="Index" asp-route-tab="@ScheduleTabs.Availability"><i class="bi bi-calendar-check" aria-hidden="true"></i> Availability</a>
            </li>
        }
        @if (Model.CanBook)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.Tab == ScheduleTabs.Book ? "active" : "")" aria-current="@(Model.Tab == ScheduleTabs.Book ? "page" : null)"
                   asp-action="Index" asp-route-tab="@ScheduleTabs.Book"><i class="bi bi-person-check" aria-hidden="true"></i> Check in to classes</a>
            </li>
        }
        @if (Model.HasCheckIns)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.Tab == ScheduleTabs.CheckIns ? "active" : "")" aria-current="@(Model.Tab == ScheduleTabs.CheckIns ? "page" : null)"
                   asp-action="Index" asp-route-tab="@ScheduleTabs.CheckIns"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Who's coming</a>
            </li>
        }
    </ul>
</nav>

@if (Model.Tab == ScheduleTabs.Week)
{
    @if (Model.Organizations.Count > 1)
    {
        <ul class="legend mb-3" aria-label="Organisations">
            @foreach (var organization in Model.Organizations)
            {
                <li><span class="legend-swatch @DisplayNames.ToneClass(Model.Tones[organization.Id])" aria-hidden="true"></span> @organization.Name</li>
            }
        </ul>
    }

    @if (clashes.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i>
            <strong>@DisplayNames.Plural(clashes.Count, "class", "classes") clash.</strong>
            You can't be in two places at once: tell the organisations involved, so one of them can move a class.
            <ul class="mb-0 mt-2">
                @foreach (var clash in clashes)
                {
                    <li>@clash.Session.Group!.Course!.Name (@clash.Organization.Name), @clash.Session.Day @clash.Session.Starts.ToString("HH:mm"): @clash.Clash</li>
                }
            </ul>
        </div>
    }

    <partial name="_WeekGrid" model="Model.Grid" />
}
else if (Model.Tab == ScheduleTabs.Book)
{
    <p class="text-muted">These courses are paid per class. Check in to each class you'll come to, up to four weeks ahead;
       it keeps your place, and it's how you're billed.</p>

    @foreach (var day in Model.Classes.GroupBy(c => c.Date))
    {
        <h2 class="section-title mt-4">@DisplayNames.LongDate(day.Key)</h2>
        <ul class="class-list">
            @foreach (var item in day)
            {
                var session = item.Session;
                var rules = Model.CancelRules[item.Organization.Id];
                var cancelBy = item.Starts.AddHours(-rules.CancelHours);
                bool lateNow = rules.BillNoShows && Clock.SchoolNow() > cancelBy;
                <li class="class-row @DisplayNames.ToneClass(Model.Tones.GetValueOrDefault(item.Organization.Id)) @(item.Mine != null ? "booked" : "")">
                    <div class="class-time">@session.Starts.ToString("HH:mm")<span>–@session.Ends.ToString("HH:mm")</span></div>
                    <div class="class-what">
                        <strong lang="@session.Group!.Course!.Name.Language()">@session.Group.Course.Name</strong>
                        <div class="text-muted small">
                            <span lang="@item.Organization.Name.Language()">@item.Organization.Name</span> · @session.Classroom!.Name
                            @if (session.Group.Teacher != null) { <text> · @session.Group.Teacher.FullName</text> }
                            · @DisplayNames.Money(item.Price) a class
                        </div>
                        @if (item.Mine != null)
                        {
                            <div class="small text-success-emphasis"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> You're checked in.
                                @if (lateNow)
                                {
                                    <text>It's too late to cancel for free: cancelling now still bills it.</text>
                                }
                                else if (rules.BillNoShows)
                                {
                                    <text>Free cancellation until @DisplayNames.ShortDate(DateOnly.FromDateTime(cancelBy)) @cancelBy.ToString("HH:mm").</text>
                                }
                            </div>
                        }
                        else if (item.CancelledLate && rules.BillNoShows)
                        {
                            <div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                You cancelled less than @DisplayNames.Plural(rules.CancelHours, "hour") before, so this class is still billed. Check in again if you can come after all.</div>
                        }
                    </div>
                    <div class="class-action">
                        @if (item.Mine != null)
                        {
                            <form asp-action="CancelBooking" asp-route-bookingId="@item.Mine.Id" method="post"
                                  data-confirm="Cancel your check-in to @session.Group.Course.Name on @DisplayNames.LongDate(item.Date)?@(lateNow ? $" It will still be billed ({DisplayNames.Money(item.Price)})." : rules.BillNoShows ? $" After {DisplayNames.ShortDate(DateOnly.FromDateTime(cancelBy))} {cancelBy:HH:mm} it's still billed." : "")">
                                <button class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                        else if (item.Left == 0)
                        {
                            <span class="status-pill status-rejected">Full</span>
                        }
                        else
                        {
                            <form asp-action="Book" method="post">
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <input type="hidden" name="date" value="@item.Date.ToString("yyyy-MM-dd")" />
                                <button class="btn btn-sm btn-primary">Check in</button>
                            </form>
                            <div class="small text-muted mt-1">@DisplayNames.Plural(item.Left, "place") left</div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
}
else if (Model.Tab == ScheduleTabs.CheckIns)
{
    <p class="text-muted">Your per-class classes, from last week to two weeks ahead. Open one to see who checked in, and after
       the class, mark anyone who didn't come.</p>
    <partial name="_ClassDates" model="@(new ClassDatesModel(Model.Classes, c => Url.Action("Roster", "MySchedule", new { organizationId = c.Organization.Id, sessionId = c.Session.Id, date = c.Date.ToString("yyyy-MM-dd") })!))" />
}
else @* Availability *@
{
    <p class="text-muted">Tell each organisation when you can teach there. Admins see it when they build the timetable,
       and classes outside it are flagged to them.</p>

    @foreach (var place in Model.Places)
    {
        var rules = place.Rules;
        <section class="form-card mb-4" aria-labelledby="place-@place.Organization.Id">
            <h2 class="section-title" id="place-@place.Organization.Id">
                <span class="legend-swatch @DisplayNames.ToneClass(Model.Tones.GetValueOrDefault(place.Organization.Id))" aria-hidden="true"></span>
                @place.Organization.Name
            </h2>
            <p class="text-muted small">Teaching there happens @rules.TeachingDays.Display(), @rules.DayStarts.ToString("HH:mm")–@rules.DayEnds.ToString("HH:mm").</p>

            @if (place.Slots.Count == 0)
            {
                <p><em>You haven't posted any times yet.</em></p>
            }
            else
            {
                <ul class="slot-list">
                    @foreach (var slot in place.Slots)
                    {
                        <li>
                            <span><strong>@slot.Day</strong> @slot.From.ToString("HH:mm")–@slot.To.ToString("HH:mm")</span>
                            <form asp-action="RemoveAvailability" asp-route-availabilityId="@slot.Id" method="post" class="d-inline"
                                  data-confirm="Remove @slot.Day @slot.From.ToString("HH:mm")–@slot.To.ToString("HH:mm") at @place.Organization.Name?">
                                <button class="btn btn-sm btn-link text-danger p-0" aria-label="Remove @slot.Day @slot.From.ToString("HH:mm")–@slot.To.ToString("HH:mm")">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i> Remove
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form asp-action="AddAvailability" method="post" class="row g-2 align-items-end mt-1">
                <input type="hidden" name="OrganizationId" value="@place.Organization.Id" />
                <div class="col-sm-4">
                    <label class="form-label small mb-1" for="day-@place.Organization.Id">Day</label>
                    <select class="form-select" id="day-@place.Organization.Id" name="Day" required>
                        @foreach (var day in DisplayNames.Week)
                        {
                            <option value="@day" selected="@(rules.TeachingDays.HasFlag(day.ToTeachingDay()) && day == rules.TeachingDays.Days().First())">@day</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label small mb-1" for="from-@place.Organization.Id">From</label>
                    <input class="form-control" type="time" id="from-@place.Organization.Id" name="From" value="@rules.DayStarts.ToString("HH:mm")" required />
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label small mb-1" for="to-@place.Organization.Id">To</label>
                    <input class="form-control" type="time" id="to-@place.Organization.Id" name="To" value="@rules.DayEnds.ToString("HH:mm")" required />
                </div>
                <div class="col-sm-2">
                    <button type="submit" class="btn btn-primary w-100">Add</button>
                </div>
            </form>
        </section>
    }
}
