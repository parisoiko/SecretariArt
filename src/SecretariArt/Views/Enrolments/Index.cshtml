@model EnrolmentsViewModel
@{
    var organization = (Organization)ViewData["Organization"]!;
    ViewData["Title"] = $"Enrolments · {organization.Name}";
}

@{ Layout = "_AdminLayout"; ViewData["AdminTab"] = "enrolments"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted mb-0">Every approved student and the courses they take. Open a student to enrol them in a course or a whole bundle.</p>
    <form method="get" class="d-flex gap-2" role="search">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Name or email" aria-label="Search students" />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Search</span></button>
    </form>
</div>

@if (Model.CourseCount == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>There are no courses to enrol in yet.
        <a asp-controller="Courses" asp-action="Create" asp-route-organizationId="@organization.Id">Add a course</a> first.
    </div>
}

@if (Model.Students.Count == 0)
{
    <div class="empty-state small">
        <i class="bi bi-person-check" aria-hidden="true"></i>
        @if (string.IsNullOrWhiteSpace(Model.Search))
        {
            <p>No approved students yet. Share your invite code on the
               <a asp-controller="Administration" asp-action="Members" asp-route-organizationId="@organization.Id">Members</a> tab.</p>
        }
        else
        {
            <p>No student matches “@Model.Search”. <a asp-action="Index" asp-route-organizationId="@organization.Id">Show everyone</a></p>
        }
    </div>
}
else
{
    <div class="table-responsive table-card">
        <table class="table align-middle mb-0 table-stack">
            <thead><tr><th>Student</th><th>Courses</th><th></th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Students)
                {
                    <tr>
                        <td data-label="Student">
                            <strong lang="@entry.Student.FullName.Language()">@entry.Student.FullName</strong>
                            <div class="text-muted small">@entry.Student.Email</div>
                        </td>
                        <td data-label="Courses">
                            @if (entry.Enrolments.Count == 0)
                            {
                                <span class="text-muted">Not enrolled yet</span>
                            }
                            @foreach (var enrolment in entry.Enrolments)
                            {
                                <span class="course-chip">@enrolment.Course!.Name <span class="text-muted">· @enrolment.Group!.Name</span></span>
                            }
                        </td>
                        <td class="text-end text-nowrap table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Student" asp-route-organizationId="@organization.Id"
                               asp-route-studentId="@entry.Student.Id"><i class="bi bi-pencil-square" aria-hidden="true"></i> Enrol</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
