@model SessionFormViewModel
@{
    var organization = (Organization)ViewData["Organization"]!;
    var current = Model.Current!;
    string title = $"{current.Group.Course!.Name} · group {current.Group.Name}";
    ViewData["Title"] = $"{title} · Schedule · {organization.Name}";
}

<partial name="_AdminHeader" model="@("schedule")" />

<a class="back-link" asp-action="Index" asp-route-organizationId="@organization.Id"><i class="bi bi-arrow-left" aria-hidden="true"></i> Whole timetable</a>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="detail-card">
            <h2 class="mb-1">@title</h2>
            <dl class="facts">
                <div><dt>Now</dt><dd>@current.Session.Day @current.Session.Starts.ToString("HH:mm")–@current.Session.Ends.ToString("HH:mm")</dd></div>
                <div><dt>Room</dt><dd>@current.Room.Name</dd></div>
                <div><dt>Teacher</dt><dd>@(current.Group.Teacher?.FullName ?? "Not decided yet")</dd></div>
                <div><dt>Students</dt><dd>@current.Group.Enrolments.Count of @current.Group.Capacity</dd></div>
            </dl>
            @if (current.Problems.Count > 0 || current.Warnings.Count > 0)
            {
                <ul class="issue-list mt-3 mb-0">
                    @foreach (var problem in current.Problems)
                    {
                        <li class="problem"><span class="visually-hidden">Clash:</span> @problem</li>
                    }
                    @foreach (var warning in current.Warnings)
                    {
                        <li class="warning"><span class="visually-hidden">Check:</span> @warning</li>
                    }
                </ul>
            }
            <form asp-action="Delete" asp-route-organizationId="@organization.Id" asp-route-sessionId="@current.Session.Id" method="post" class="mt-3"
                  data-confirm="Take @title on @current.Session.Day @current.Session.Starts.ToString("HH:mm") off the timetable? Its teacher and students will be told.">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> Remove from timetable</button>
            </form>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="form-card">
            <h2 class="section-title">Move it</h2>
            <partial name="_SessionForm" model="Model" />
            <p class="form-text mt-2 mb-0">Its teacher and students get a notification when it moves.</p>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScripts" /> }
