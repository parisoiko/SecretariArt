@model AccountPageViewModel
@{
    ViewData["Title"] = "My account";
}

<div class="narrow">
    <header class="page-header">
        <h1>My account</h1>
        <p>Signed in as <span>@Html.Email(Model.Email)</span>. Your details are the same in every organisation you belong to.</p>
    </header>

    <section class="mb-4" aria-labelledby="details-heading">
        <h2 id="details-heading" class="h5">Your details</h2>
        <form asp-action="Index" method="post" class="form-card" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="Profile.FirstName" class="form-label"></label>
                    <input asp-for="Profile.FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Profile.FirstName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Profile.LastName" class="form-label"></label>
                    <input asp-for="Profile.LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Profile.LastName" class="invalid-feedback d-block"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                <input asp-for="Profile.PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                <span asp-validation-for="Profile.PhoneNumber" class="invalid-feedback d-block"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save details</button>
        </form>
    </section>

    <section aria-labelledby="password-heading">
        <h2 id="password-heading" class="h5">Change password</h2>
        <form asp-action="ChangePassword" method="post" class="form-card" novalidate>
            <input type="hidden" autocomplete="username" value="@Model.Email" />
            <div class="mb-3">
                <label asp-for="Password.CurrentPassword" class="form-label"></label>
                <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password.CurrentPassword" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password.NewPassword" class="form-label"></label>
                <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                <div id="password-hint" class="form-text">At least 8 characters, with an upper-case letter, a lower-case letter and a digit. Other devices will be signed out.</div>
                <span asp-validation-for="Password.NewPassword" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password.ConfirmPassword" class="invalid-feedback d-block"></span>
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </form>
    </section>
</div>

@section Scripts { <partial name="_ValidationScripts" /> }
