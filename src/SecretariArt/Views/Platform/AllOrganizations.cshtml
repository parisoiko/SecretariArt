@model AllOrganizationsViewModel
@{
    ViewData["Title"] = "All organisations";
    string Label(OrganizationStatus? status) => status switch
    {
        null => "All",
        OrganizationStatus.Pending => "Waiting",
        OrganizationStatus.Active => "Active",
        _ => "Rejected",
    };
    OrganizationStatus?[] filters = [null, OrganizationStatus.Active, OrganizationStatus.Pending, OrganizationStatus.Rejected];
}

<partial name="_Tabs" model="@("all")" />

<div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Filter by status">
    @foreach (var filter in filters)
    {
        <a class="btn btn-sm @(Model.Status == filter ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(Model.Status == filter ? "true" : null)"
           asp-action="AllOrganizations" asp-route-status="@filter">@Label(filter)</a>
    }
</div>

@if (Model.Organizations.Count == 0)
{
    <div class="empty-state small">
        <i class="bi bi-buildings"></i>
        <p>No organisations here.</p>
    </div>
}
else
{
    <div class="table-responsive table-card">
        <table class="table align-middle mb-0 table-stack">
            <thead><tr><th>Organisation</th><th>Type</th><th>Requested by</th><th>Status</th><th>Sent</th><th>Decided</th></tr></thead>
            <tbody>
                @foreach (var organization in Model.Organizations)
                {
                    <tr>
                        <td data-label="Organisation"><strong>@organization.Name</strong><div class="text-muted small">@organization.City</div></td>
                        <td data-label="Type">@organization.Type.Display()</td>
                        <td data-label="Requested by">@organization.RequestedBy!.FullName<div class="text-muted small">@organization.RequestedBy.Email</div></td>
                        <td data-label="Status">
                            <span class="status-pill status-@organization.Status.ToString().ToLowerInvariant()">@Label(organization.Status)</span>
                            @if (organization.RejectionReason != null)
                            {
                                <div class="text-muted small">@organization.RejectionReason</div>
                            }
                        </td>
                        <td data-label="Sent" class="text-nowrap">@organization.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td data-label="Decided" class="text-nowrap">@organization.ReviewedAt?.ToLocalTime().ToString("d MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
