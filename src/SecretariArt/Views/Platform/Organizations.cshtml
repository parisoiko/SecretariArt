@model List<Organization>
@{
    ViewData["Title"] = "Organisations waiting";
}

<partial name="_Tabs" model="@("waiting")" />

@if (Model.Count == 0)
{
    <div class="empty-state small">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <p>No requests waiting.</p>
    </div>
}
else
{
    <div class="table-responsive table-card">
        <table class="table align-middle mb-0 table-stack">
            <thead>
                <tr><th>Organisation</th><th>Type</th><th>Requested by</th><th>Contact</th><th>Sent</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var organization in Model)
                {
                    <tr>
                        <td data-label="Organisation"><strong>@organization.Name</strong><div class="text-muted small">@organization.City</div></td>
                        <td data-label="Type">@organization.Type.Display()</td>
                        <td data-label="Requested by">@organization.RequestedBy!.FullName<div class="text-muted small">@organization.RequestedBy.Email</div></td>
                        <td data-label="Contact">@organization.ContactEmail<div class="text-muted small">@organization.ContactPhone</div></td>
                        <td data-label="Sent" class="text-nowrap">@organization.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td class="text-end text-nowrap table-actions">
                            <form asp-action="Approve" asp-route-id="@organization.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-success"><i class="bi bi-check-lg" aria-hidden="true"></i> Approve</button>
                            </form>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Reject" asp-route-id="@organization.Id"><i class="bi bi-x-lg" aria-hidden="true"></i> Reject</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
