@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="narrow-wide">
    <header class="page-header">
        <h1>Notifications</h1>
        <p>Changes to your classes (new ones, moves and cancellations) and news about your payments: reminders, payments received and new charges.</p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="empty-state small"><i class="bi bi-bell" aria-hidden="true"></i><p>Nothing yet.</p></div>
    }
    else
    {
        <ul class="notification-list">
            @foreach (var notification in Model)
            {
                <li class="@(notification.ReadAt == null ? "unread" : "")">
                    @if (notification.ReadAt == null)
                    {
                        <span class="visually-hidden">New:</span>
                    }
                    <span class="notification-text">@notification.Text</span>
                    <span class="notification-meta">
                        @notification.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")
                        @if (notification.Url != null)
                        {
                            <a href="@notification.Url">Open</a>
                        }
                    </span>
                </li>
            }
        </ul>
    }
</div>
