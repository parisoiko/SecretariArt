@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
    Layout = "_AuthLayout";
}

<h2>Create your account</h2>
<p class="text-muted">One account for every school you work or study at.</p>

<form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-sm-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus />
            <span asp-validation-for="FirstName" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" placeholder="+30 690 123 4567" />
            <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12 form-text mt-1">At least 8 characters, with an upper-case letter, a lower-case letter and a digit.</div>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-4">Create account</button>
</form>

<p class="mt-4 mb-0 text-center">
    Already have an account? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Sign in</a>
</p>

@section Scripts { <partial name="_ValidationScripts" /> }
