@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<h2>Choose a new password</h2>
<p class="text-muted">For <span>@Html.Email(Model.Email)</span>. At least 8 characters, with an upper-case letter, a lower-case letter and a digit.</p>

<form asp-action="ResetPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (ViewData["LinkExpired"] is true)
    {
        <p><a asp-action="ForgotPassword" asp-route-email="@Model.Email">Send me a new link</a></p>
    }
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Code" />
    @* Lets password managers save the new password against the right account. *@
    <input type="hidden" autocomplete="username" value="@Model.Email" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Change password</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
