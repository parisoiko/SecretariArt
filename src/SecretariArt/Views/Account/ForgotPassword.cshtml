@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "_AuthLayout";
}

<h2>Forgot your password?</h2>
<p class="text-muted">Enter the email you signed up with and we'll send you a link to choose a new password.</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Send the link</button>
</form>

<p class="mt-4 mb-0 text-center">
    Remembered it? <a asp-action="Login" asp-route-email="@Model.Email">Sign in</a>
</p>

@section Scripts { <partial name="_ValidationScripts" /> }
