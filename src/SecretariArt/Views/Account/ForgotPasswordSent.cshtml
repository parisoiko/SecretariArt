@model string
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<h2>Check your email</h2>
<p>If <strong>@Html.Email(Model)</strong> has an account, we've sent it a link to choose a new password.
   The link works for two hours.</p>
<p class="text-muted">Nothing arrived? Check your spam folder, or <a asp-action="ForgotPassword" asp-route-email="@Model">ask again</a>.</p>

<a class="btn btn-primary w-100 mt-2" asp-action="Login" asp-route-email="@Model">Back to sign in</a>
