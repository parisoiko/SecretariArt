@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var active = Model.ActiveOrganizations;
    string today = DisplayNames.DayAndDate(Model.Today);
}

@if (Model.IsNewcomer)
{
    <div class="welcome">
        <header class="welcome-head">
            <h1>Welcome, @Model.FirstName</h1>
            <p>You're not part of any organisation yet. Join your school or studio, or register your own to start running it here.</p>
        </header>

        <div class="welcome-grid">
            <section class="welcome-card" aria-labelledby="join">
                <span class="icon-tile" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
                <div>
                    <h2 id="join">Join with an invite code</h2>
                    <p>For students and teachers. Your school gives you the code.</p>
                </div>
                <form asp-controller="Organizations" asp-action="Join" method="get" class="welcome-form">
                    <label for="code" class="form-label">Invite code</label>
                    <div class="d-flex gap-2">
                        <input id="code" name="code" class="form-control code-input" placeholder="e.g. K7Q2MX9P" autocomplete="off" required />
                        <button type="submit" class="btn btn-primary">Join</button>
                    </div>
                </form>
            </section>

            <section class="welcome-card" aria-labelledby="register">
                <span class="icon-tile" aria-hidden="true"><i class="bi bi-building"></i></span>
                <div>
                    <h2 id="register">Register your organisation</h2>
                    <p>Run a school, studio or art space? Once we approve it, you become its admin.</p>
                </div>
                <ol class="steps">
                    <li><span>1</span>Tell us about it</li>
                    <li><span>2</span>We review the request</li>
                    <li><span>3</span>Invite your teachers and students</li>
                </ol>
                <a class="btn btn-outline-primary mt-auto" asp-controller="Organizations" asp-action="RequestOrganization">Start a request</a>
            </section>
        </div>

        @if (Model.HasRequests)
        {
            <div class="welcome-requests">
                <partial name="_YourRequests" model="Model" />
            </div>
        }
        else
        {
            <p class="welcome-foot">Requests you send will show on this page until they're answered.</p>
        }
    </div>
    return;
}

<header class="home-head">
    <p class="home-date">@today</p>
    <h1>Hello, @Model.FirstName</h1>
</header>

<div class="home-grid">
    <div class="home-main">
        @if (Model.IsPlatformAdmin)
        {
            <section class="panel" aria-labelledby="platform">
                <div class="panel-head">
                    <h2 id="platform">Platform</h2>
                    @if (Model.PlatformRequestsWaiting > 0)
                    {
                        <span class="count-badge">@Model.PlatformRequestsWaiting</span>
                    }
                </div>
                <div class="quick-links two panel-body">
                    <a class="quick-link" asp-controller="Platform" asp-action="Organizations">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                        Organisation requests
                        <small>@(Model.PlatformRequestsWaiting > 0 ? $"{Model.PlatformRequestsWaiting} waiting" : "Nothing waiting")</small>
                    </a>
                    <a class="quick-link" asp-controller="Platform" asp-action="AllOrganizations">
                        <i class="bi bi-buildings" aria-hidden="true"></i>
                        All organisations
                        <small>Every organisation, with past decisions</small>
                    </a>
                </div>
            </section>
        }

        @if (Model.JoinRequests.Count > 0)
        {
            <section class="panel" aria-labelledby="attention">
                <div class="panel-head">
                    <h2 id="attention">Needs your attention</h2>
                    <span class="count-badge">@Model.PendingJoinRequests.Values.Sum()</span>
                </div>
                @foreach (var request in Model.JoinRequests)
                {
                    ApplicationUser user = request.User!;
                    string role = request.Role.ToString();
                    <div class="request-row">
                        <div class="request-main">
                            <span class="avatar avatar-lg" aria-hidden="true">@user.Initials</span>
                            <div class="request-who">
                                <p class="mb-0 fw-semibold"><span lang="@user.FullName.Language()">@user.FullName</span> wants to join as a @role.ToLowerInvariant()</p>
                                <p class="request-meta"><span lang="@request.Organization!.Name.Language()">@request.Organization.Name</span> · asked @request.RequestedAt.ToLocalTime().ToString("d MMM")@(request.LastRejectedAt != null ? " · turned down before" : "")</p>
                            </div>
                            <div class="request-actions">
                                <a class="btn btn-outline-secondary" asp-controller="Administration" asp-action="Members" asp-route-organizationId="@request.OrganizationId"
                                   aria-label="Review @user.FullName's request">Review</a>
                                <form asp-controller="Administration" asp-action="Approve" asp-route-organizationId="@request.OrganizationId"
                                      asp-route-membershipId="@request.Id" asp-route-returnUrl="/" method="post">
                                    <button class="btn btn-primary" aria-label="Approve @user.FullName">Approve</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        @if (active.Count > 0)
        {
            <section aria-labelledby="orgs">
                <h2 id="orgs" class="home-section-title">Your organisations</h2>
                <div class="org-cards">
                    @foreach (var organization in active)
                    {
                        Organization details = organization.First().Organization!;
                        bool isAdmin = organization.Any(m => m.Role == MembershipRole.Admin);
                        bool isStudent = organization.Any(m => m.Role == MembershipRole.Student);
                        bool isTeacher = organization.Any(m => m.Role == MembershipRole.Teacher);
                        Model.PendingJoinRequests.TryGetValue(organization.Key, out int pendingRequests);
                        <article class="org-card">
                            <div class="org-card-head">
                                <span class="org-mark" aria-hidden="true">@details.Name.Trim().FirstOrDefault()</span>
                                <div class="min-w-0 flex-grow-1">
                                    <p class="eyebrow">@details.Type.Display() · <span lang="@details.City.Language()">@details.City</span></p>
                                    <h3 lang="@details.Name.Language()">@details.Name</h3>
                                </div>
                                <div class="org-card-roles">
                                    @foreach (var membership in organization.OrderBy(m => m.Role))
                                    {
                                        <partial name="_RoleBadge" model="membership.Role" />
                                    }
                                </div>
                            </div>
                            <div class="quick-links">
                                @if (isAdmin)
                                {
                                    <a class="quick-link" asp-controller="Administration" asp-action="Members" asp-route-organizationId="@organization.Key"><i class="bi bi-people" aria-hidden="true"></i>Members</a>
                                    <a class="quick-link" asp-controller="Classrooms" asp-action="Index" asp-route-organizationId="@organization.Key"><i class="bi bi-door-open" aria-hidden="true"></i>Classrooms</a>
                                    <a class="quick-link" asp-controller="Courses" asp-action="Index" asp-route-organizationId="@organization.Key"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Courses</a>
                                }
                                else
                                {
                                    <a class="quick-link" asp-controller="MySchedule" asp-action="Index"><i class="bi bi-calendar3" aria-hidden="true"></i>@(isTeacher ? "Teaching" : "My classes")</a>
                                    @if (isTeacher)
                                    {
                                        <a class="quick-link" asp-controller="MySchedule" asp-action="Index" asp-route-tab="availability"><i class="bi bi-calendar-check" aria-hidden="true"></i>Availability</a>
                                    }
                                    @if (isStudent)
                                    {
                                        <a class="quick-link" asp-controller="MyPayments" asp-action="Index"><i class="bi bi-wallet2" aria-hidden="true"></i>Payments</a>
                                    }
                                }
                            </div>
                            @if (pendingRequests > 0)
                            {
                                <a class="org-alert" asp-controller="Administration" asp-action="Members" asp-route-organizationId="@organization.Key">
                                    <span class="dot" aria-hidden="true"></span>
                                    @DisplayNames.Plural(pendingRequests, "join request") to review
                                    <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                                </a>
                            }
                        </article>
                    }

                    <div class="org-card-dashed">
                        <p class="org-card-dashed-title">Part of another school?</p>
                        <p class="text-muted small mb-0">The same account works everywhere. Teach at one place, study at another.</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-primary" asp-controller="Organizations" asp-action="Join">Join with a code</a>
                            <a class="btn btn-outline-secondary" asp-controller="Organizations" asp-action="RequestOrganization">Register one</a>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>

    <aside class="home-aside" aria-label="Requests and what's coming up">
        @if (Model.HasRequests)
        {
            <partial name="_YourRequests" model="Model" />
        }

        <section class="coming-up" aria-labelledby="coming-up">
            <h2 id="coming-up" class="eyebrow">Coming up</h2>
            @if (Model.TodaysClasses.Count == 0 && Model.PaymentsDue.Count == 0)
            {
                <p class="text-muted small mb-0">Nothing today. Your classes and payment deadlines show here.</p>
            }
            @if (Model.TodaysClasses.Count > 0)
            {
                <p class="coming-up-label">Today</p>
                <ul class="coming-list">
                    @foreach (var item in Model.TodaysClasses)
                    {
                        <li class="@(item.Clash != null ? "clash" : "")">
                            <span class="coming-time">@item.Session.Starts.ToString("HH:mm")</span>
                            <span>
                                <span lang="@item.Session.Group!.Course!.Name.Language()">@item.Session.Group.Course.Name</span>@(item.Teaching ? " · teaching" : "")
                                <small>@item.Session.Classroom!.Name · <span lang="@item.Organization.Name.Language()">@item.Organization.Name</span></small>
                                @if (item.Clash != null)
                                {
                                    <small class="text-danger"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Clashes: @item.Clash</small>
                                }
                            </span>
                        </li>
                    }
                </ul>
                <a class="small" asp-controller="MySchedule" asp-action="Index">Your week</a>
            }
            @if (Model.PaymentsDue.Count > 0)
            {
                <p class="coming-up-label">Payments</p>
                <ul class="coming-list">
                    @foreach (var charge in Model.PaymentsDue)
                    {
                        bool overdue = charge.IsOverdue(Model.Today);
                        <li class="@(overdue ? "clash" : "")">
                            <span class="coming-time money">@DisplayNames.Money(charge.Balance)</span>
                            <span>
                                @charge.Description
                                <small class="@(overdue ? "text-danger fw-semibold" : "")">@(overdue ? $"Overdue since {DisplayNames.ShortDate(charge.DueOn)}" : $"Due {DisplayNames.ShortDate(charge.DueOn)}") · <span lang="@charge.Organization!.Name.Language()">@charge.Organization.Name</span></small>
                            </span>
                        </li>
                    }
                </ul>
                <a class="small" asp-controller="MyPayments" asp-action="Index">All payments</a>
            }
        </section>
    </aside>
</div>
