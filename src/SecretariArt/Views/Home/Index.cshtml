@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var active = Model.Memberships
        .Where(m => m.Status == MembershipStatus.Active && m.Organization!.Status == OrganizationStatus.Active)
        // By id: each membership carries its own copy of the organisation, so grouping by the object would give one
        // card per role.
        .GroupBy(m => m.OrganizationId)
        .ToList();
    var waiting = Model.Memberships.Where(m => m.Status != MembershipStatus.Active).ToList();
    bool isPlatformAdmin = Model.PlatformRequestsWaiting != null;
    // A platform admin with no memberships of their own has no use for "join a school".
    bool showGettingStarted = !isPlatformAdmin || Model.Memberships.Count > 0;
}

<header class="page-header">
    <h1>Hello, @Model.FirstName</h1>
    <p>@(active.Count > 0 ? "Here are your organisations." : isPlatformAdmin ? "Here's what needs your attention." : "Let's get you connected to your school.")</p>
</header>

@if (isPlatformAdmin)
{
    <section class="action-grid mb-4">
        <a class="action-card" asp-controller="Platform" asp-action="Organizations">
            <i class="bi bi-inbox"></i>
            <h3>Organisation requests</h3>
            <p>
                @if (Model.PlatformRequestsWaiting > 0)
                {
                    <span class="badge text-bg-warning">@Model.PlatformRequestsWaiting waiting</span>
                }
                else
                {
                    <span>Nothing waiting.</span>
                }
            </p>
        </a>
        <a class="action-card" asp-controller="Platform" asp-action="AllOrganizations">
            <i class="bi bi-buildings"></i>
            <h3>All organisations</h3>
            <p>Every organisation on SecretariArt, with past decisions.</p>
        </a>
    </section>
}

@if (active.Count > 0)
{
    <div class="org-grid mb-4">
        @foreach (var organization in active)
        {
            Organization details = organization.First().Organization!;
            bool isAdmin = organization.Any(m => m.Role == MembershipRole.Admin);
            Model.PendingJoinRequests.TryGetValue(organization.Key, out int pendingRequests);
            <article class="org-card">
                <div class="org-type">@details.Type.Display() · <span lang="@details.City.Language()">@details.City</span></div>
                <h2>@details.Name</h2>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var membership in organization.OrderBy(m => m.Role))
                    {
                        <span class="role-badge role-@membership.Role.ToString().ToLowerInvariant()">@membership.Role</span>
                    }
                </div>
                @if (isAdmin)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Administration" asp-action="Members" asp-route-organizationId="@organization.Key">
                        <i class="bi bi-people"></i> Members
                        @if (pendingRequests > 0)
                        {
                            <span class="badge text-bg-warning ms-1">@pendingRequests waiting</span>
                        }
                    </a>
                }
            </article>
        }
    </div>
}

@if (waiting.Count > 0 || Model.OrganizationRequests.Count > 0)
{
    <section class="mb-4">
        <h2 class="section-title">Requests</h2>
        <ul class="list-group">
            @foreach (var membership in waiting)
            {
                bool rejected = membership.Status == MembershipStatus.Rejected;
                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <span>
                        Join <strong>@membership.Organization!.Name</strong> as a @membership.Role.ToString().ToLowerInvariant()
                        <span class="text-muted small d-block">Asked @membership.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                        @if (rejected && membership.RejectionReason != null)
                        {
                            <span class="small d-block">Reason: @membership.RejectionReason</span>
                        }
                    </span>
                    <span class="status-pill status-@membership.Status.ToString().ToLowerInvariant()">@(rejected ? "Not approved" : "Waiting for approval")</span>
                </li>
            }
            @foreach (var request in Model.OrganizationRequests)
            {
                bool rejected = request.Status == OrganizationStatus.Rejected;
                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <span>
                        New organisation <strong>@request.Name</strong>
                        <span class="text-muted small d-block">Sent @request.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                        @if (rejected && request.RejectionReason != null)
                        {
                            <span class="small d-block">Reason: @request.RejectionReason</span>
                        }
                    </span>
                    <span class="status-pill status-@request.Status.ToString().ToLowerInvariant()">@(rejected ? "Not approved" : "Under review")</span>
                </li>
            }
        </ul>
    </section>
}

@if (showGettingStarted)
{
    <section class="action-grid">
        <a class="action-card" asp-controller="Organizations" asp-action="Join">
            <i class="bi bi-person-plus"></i>
            <h3>Join an organisation</h3>
            <p>Have an invite code from your school or studio? Join as a student or a teacher.</p>
        </a>
        <a class="action-card" asp-controller="Organizations" asp-action="RequestOrganization">
            <i class="bi bi-building-add"></i>
            <h3>Register your organisation</h3>
            <p>Run a school, studio or art space? Ask for it to be set up and you'll become its admin.</p>
        </a>
    </section>
}
